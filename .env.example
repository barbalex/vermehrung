# Frontend build environment — copy to .env.development (gitignored).
# Only VITE_* variables reach the client (vite's default envPrefix).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_UPLOADCARE_PUBLIC_KEY=

# Production error reports (src/modules/errorTelemetry.ts): the PostgREST
# error_report table. Leave EMPTY here - without it error telemetry is a
# complete no-op (dev builds report nothing). Production (.env.production,
# gitignored) sets it to https://api.vermehrung.ch/error_report
VITE_ERROR_TELEMETRY_URL=

# The historical .env.development also carries HASURA_* vars (dead since
# the PostgREST migration) and UPLOADCARE_SECRET_KEY (no VITE_ prefix —
# vite never exposes it, src/components/Uploader.tsx reads it as
# `import.meta.env.UPLOADCARE_SECRET_KEY`, which is always undefined).
# Both are unused; safe to delete from your local copy.
