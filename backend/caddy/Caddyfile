# PostgREST handles CORS (including OPTIONS preflight) itself
api.vermehrung.ch {
  reverse_proxy * {
    to v_api:3000
  }
}

auth.vermehrung.ch {
  reverse_proxy * {
    to v_auth:7000
    header_down Access-Control-Allow-Origin *
    header_down Access-Control-Allow-Methods "HEAD, GET, POST, OPTIONS"
  }
}
