  email alex.barbalex@gmail.com
  #acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# PostgREST handles CORS (including OPTIONS preflight) itself
api.vermehrung.ch {
  reverse_proxy * {
    to v_api:3000
  }
}

# hapi handles cors itself (including the /token preflight)
auth.vermehrung.ch {
  reverse_proxy * {
    to v_auth:7000
    # the /events SSE stream must not be buffered
    flush_interval -1
  }
}

# blue-borders.ch / mediterranean-migration.com: purely static
# documentation site (frozen). the pages are prerendered in the bb4 repo
# and rsynced to /root/bb/dist by bb4's npm run deploy
(blue-borders-static) {
	encode gzip
	# the site is frozen documentation; the last documented year is 2024
	redir / /events/2024/ 308
	redir /events /events/2024/ 308
	redir /events/ /events/2024/ 308
	root * /srv-bb
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}

blue-borders.ch,
www.blue-borders.ch,
mediterranean-migration.com,
www.mediterranean-migration.com {
	import blue-borders-static
}
